# Environment variables for GridGuard AI

# Server configuration
PORT=8000
HOST=0.0.0.0

# Optional: Google Gemini API Key for AI loss explanations
# If left empty, GridGuard AI automatically runs in deterministic Demo Explanation Mode
GEMINI_API_KEY=

# Optional: Supabase PostgreSQL credentials
# If left empty, GridGuard AI uses its built-in in-memory / local storage mode
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
